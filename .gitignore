# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database salvage backups (may contain PII)
/supabase/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temp files
supabase/.temp/

# local supabase overrides (may contain real project refs / secrets)
supabase/config.local.toml

# personal agent skills, not part of the product
.agents/

# competitive research (internal, gitignored)
/competitive-research/

# seo audits & reports (internal, gitignored)
/seo/


# content manager working folder
/.content-manager/
