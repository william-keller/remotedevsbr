# Copy to .env.local for local development and fill in your own values.
# Never commit real values. See README for details.

# Required for the frontend to talk to Supabase (Auth, database, functions).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Your public app origin. Used for canonical/OG URLs, the sitemap, and
# payment redirects (Stripe checkout/portal). Required for correct SEO and
# for the checkout edge functions to build redirect URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional frontend flags
# NEXT_PUBLIC_SIGNUP_DISABLED=true
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/your-handle
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/your-handle
# NEXT_PUBLIC_SOCIAL_WHATSAPP=https://wa.me/5511999999999

# Ebook full versions are Vercel Blob private blobs. The server route
# /ebook/download/[lang] streams them with the BLOB_READ_WRITE_TOKEN, so no
# NEXT_PUBLIC URL is needed: set BLOB_READ_WRITE_TOKEN in your Vercel project
# and upload the blobs as "LinkedIn_Performance_Playbook.pdf" (EN) and
# "LinkedIn_Performance_Playbook_pt-BR.pdf" (PT). The preview URLs below fall
# back to the free preview files under public/ebook/ when unset.
# NEXT_PUBLIC_EBOOK_PREVIEW_URL_PT=https://your-cdn/ebook/LinkedIn_Performance_Playbook_pt-BR_Preview.pdf
# NEXT_PUBLIC_EBOOK_PREVIEW_URL_EN=https://your-cdn/ebook/LinkedIn_Performance_Playbook_Preview.pdf

# Search console site verification. Emits the matching <meta name="google-site-verification">
# / <meta name="msvalidate.01"> / <meta name="yandex-verification"> tags. Optional; leave
# unset (or empty) to omit the tags entirely.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Edge Function secrets: documentation only.
#
# The Supabase Edge Functions read these via Deno.env, NOT from .env.local.
# Do NOT fill them in here. Set them on your Supabase project with:
#
#   supabase secrets set STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=...
#                       OPENAI_API_KEY=... TELEGRAM_BOT_TOKEN=...
#                       TELEGRAM_CHAT_ID=... SITE_URL=https://yourdomain.com
#
# or from the project Dashboard > Settings > Secrets (Edge Functions).
# Values here are ignored by Next.js and by the functions runtime.
# -----------------------------------------------------------------------------

# Stripe (payments: checkout, portal, webhook, subscriptions)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# OpenAI-compatible LLM API (LLM inference: analyze-resume, cover-letter, ai-tools).
# Default endpoint is OpenRouter (https://openrouter.ai/api/v1); point it elsewhere
# (e.g. https://api.openai.com/v1) by setting OPENAI_BASE_URL too.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Telegram notifications (send-notification)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Public app URL used in payment redirects (stripe-recruiter-checkout)
# SITE_URL=

# -----------------------------------------------------------------------------
# CI/CD (GitHub Actions) secrets: documentation only.
#
# The deploy job in .github/workflows/ci.yml reads these from GitHub Actions
# secrets, NOT from this file or Supabase secrets. Add them in the repo at
# Settings > Secrets and variables > Actions. If they are missing, the deploy
# job is skipped silently. The value is a project ref, never the anon/service key.
# -----------------------------------------------------------------------------

# Personal access token from https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# Supabase project reference (e.g. rnk...)
# SUPABASE_PROJECT_REF=